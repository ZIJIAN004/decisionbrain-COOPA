# Copy this file to .env and fill in your keys, then:  cp .env.example .env

# ── LLM provider ──────────────────────────────────────────────────────────────
# Used by LiteLLM for gpt / o3 / o4 / gpt-5 models (read automatically).
OPENAI_API_KEY=sk-your-openai-key

# Required only for OpenRouter-hosted models (e.g. gemini via openrouter/...).
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# ── Web search ────────────────────────────────────────────────────────────────
# Used by the web-browsing agent's Serper-backed Google search.
SERPER_API_KEY=your-serper-key
